# --- Printers ---------------------------------------------------------------
# Multiple printers: point this at a TOML/JSON file (see printers.example.toml).
# When set (or a printers.toml/printers.json exists in the working dir), it
# takes precedence over the single-printer vars below.
PRINTERS_FILE=

# Single-printer fallback (used only when no printers file is found).
MOONRAKER_URL=http://localhost:7125
# Leave blank if this host is a Moonraker "trusted client" on the LAN.
MOONRAKER_API_KEY=

# MCP HTTP server (Streamable HTTP transport)
MCP_HOST=0.0.0.0
MCP_PORT=8790
# Shared bearer token clients must send as "Authorization: Bearer <token>".
# Leave blank ONLY on a fully trusted LAN — the endpoint is then unauthenticated.
MCP_AUTH_TOKEN=

# Per-request timeout to Moonraker, in seconds.
REQUEST_TIMEOUT=10
